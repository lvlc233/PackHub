{
  "name": "@packhub/pal-electron",
  "version": "0.0.1",
  "private": true,
  "description": "PAL 的 Electron 壳：起 pal serve、加载本地界面，页面的 /api/ 请求经 preload 的 IPC 桥转给侧车",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "dev.packhub.pal",
    "productName": "PAL",
    "directories": {
      "output": "../../dist/pal-app"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "forward.mjs",
      "sidecar.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../dist/pal-runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "target": "dir"
    },
    "linux": {
      "target": "dir"
    }
  }
}
