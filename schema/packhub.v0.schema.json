{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://packhub.dev/schema/packhub.v0.schema.json",
  "title": "PackHub Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "resources"],
  "properties": {
    "apiVersion": { "const": "packhub.dev/v0" },
    "kind": { "const": "Pack" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "targets"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
        "title": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 600 },
        "license": { "type": "string" },
        "homepage": { "type": "string", "format": "uri" },
        "keywords": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,23}$" },
          "maxItems": 12,
          "uniqueItems": true
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "url": { "type": "string", "format": "uri" }
            }
          }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["dir", "dsh", "claude-code", "codex"] }
        },
        "visibility": {
          "enum": ["public", "unlisted", "internal", "private"],
          "default": "private",
          "description": "public 才会进公共索引；internal 走内网 registry；private 不发布"
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packhub"],
      "properties": {
        "packhub": { "type": "string" },
        "agent": { "type": "string" }
      }
    },
    "vars": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean"]
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/resource" }
    },
    "slots": {
      "type": "object",
      "description": "可替换位：每个槽位声明契约，资源用 slot 占位，bindings 决定装哪个",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contract": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "note": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "bindings": {
      "type": "object",
      "description": "槽位 → 资源 id；只有被绑定的实现会被安装",
      "additionalProperties": { "type": "string" }
    },
    "state": {
      "type": "array",
      "description": "持久状态目录：安装时创建，升级与卸载默认保留（记忆、索引、会话存档）；资源里用 ${state.<id>} 引用",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "相对安装根的路径；默认 .packhub/state/<id>；绝对路径与 .. 被拒"
          },
          "retain": {
            "enum": ["keep", "remove"],
            "default": "keep",
            "description": "卸载时保留（keep，默认）还是删除（remove）；删除数据必须显式写 remove"
          },
          "description": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "modify": { "$ref": "#/definitions/modify" },
    "signatures": {
      "type": "array",
      "description": "对 {pack, planHash} 的 ed25519 签名；key 是 32 字节公钥 base64",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "sig"],
        "properties": {
          "key": { "type": "string" },
          "sig": { "type": "string" },
          "at": { "type": "string" }
        }
      }
    },
    "install": { "$ref": "#/definitions/install" },
    "verify": {
      "type": "array",
      "items": { "$ref": "#/definitions/check" }
    }
  },
  "definitions": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "type": { "enum": ["mcp", "skill", "prompt", "knowledge", "config", "tool"] },
        "source": {
          "type": "string",
          "pattern": "^(npm|pypi|github|https?):.+|^\\./.*$"
        },
        "integrity": { "type": "string", "pattern": "^sha256-[A-Za-z0-9+/=]+$" },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "description": "只声明需要哪个凭证，绝不写值",
          "required": ["env"],
          "properties": {
            "env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "scheme": { "enum": ["bearer", "token", "basic"], "default": "bearer" }
          }
        },
        "slot": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "transport": { "enum": ["stdio", "http"] },
        "config": { "type": "object" },
        "provides": { "$ref": "#/definitions/capabilities" },
        "needs": { "$ref": "#/definitions/capabilities" },
        "dependsOn": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        },
        "targets": {
          "type": "array",
          "description": "只在这些 target 上安装；不写就全部安装",
          "items": { "enum": ["dir", "dsh", "claude-code", "codex"] },
          "uniqueItems": true
        },
        "optional": { "type": "boolean", "default": false }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "mcp" } }, "required": ["type"] },
          "then": { "required": ["transport"] }
        },
        {
          "if": { "properties": { "source": { "pattern": "^https?:" } }, "required": ["source"] },
          "then": { "required": ["integrity"] }
        }
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*:[a-z0-9_.]+$"
      },
      "uniqueItems": true
    },
    "modify": {
      "type": "array",
      "description": "按资源做二次修改：整份文件、一段、删掉、并参数。with 是路径则盖文件，是文本则内联，是 null 则删，是对象则并参数",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource", "with"],
        "properties": {
          "resource": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "file": { "type": "string", "minLength": 1, "description": "资源内的相对路径；单文件资源可省略" },
          "at": { "type": "string", "minLength": 1, "description": "锚点：`#` 开头是整节，否则按整行匹配；必须唯一命中" },
          "nth": { "type": "integer", "minimum": 1, "description": "命中多处时取第几个（按文档顺序，从 1 起）" },
          "where": { "enum": ["replace", "before", "after"], "default": "replace" },
          "with": {
            "oneOf": [{ "type": "string" }, { "type": "null" }, { "type": "object" }]
          },
          "note": { "type": "string", "maxLength": 200, "description": "保留字段：给作者写说明，安装器不读取" }
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exec": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command"],
            "properties": {
              "command": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } },
              "cwd": { "type": "string" },
              "env": { "type": "object", "additionalProperties": { "type": "string" } },
              "timeout": { "type": "integer", "minimum": 1 },
              "undo": {
                "type": "object",
                "description": "保留字段：目前只随 state 记录，回滚不会自动执行；命令在仓库外的副作用仍要人工清理",
                "additionalProperties": false,
                "properties": {
                  "command": { "type": "string" },
                  "args": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["file-exists", "command", "config-key", "mcp-ready", "knowledge-integrity", "scenario"] },
        "path": { "type": "string" },
        "run": { "type": "array", "items": { "type": "string" } },
        "expectExit": { "type": "integer" },
        "timeout": { "type": "integer", "minimum": 1 },
        "key": { "type": "string" },
        "equals": { "type": ["string", "number", "boolean"] },
        "resource": { "type": "string" },
        "integrity": { "type": "string" },
        "harness": { "enum": ["dsh", "claude-code", "opencode", "codex"] },
        "prompt": { "type": "string" },
        "expectOutput": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "expectFiles": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": "string" }
      }
    }
  }
}
