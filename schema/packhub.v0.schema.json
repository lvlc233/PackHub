{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://packhub.dev/schema/packhub.v0.schema.json",
  "title": "PackHub Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "resources"],
  "properties": {
    "apiVersion": { "const": "packhub.dev/v0" },
    "kind": { "const": "Pack" },
    "extends": { "type": "string", "pattern": "^packhub://[a-z0-9-]+/[a-z0-9-]+@.+$" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "targets"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
        "title": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 600 },
        "license": { "type": "string" },
        "homepage": { "type": "string", "format": "uri" },
        "keywords": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,23}$" },
          "maxItems": 12,
          "uniqueItems": true
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "url": { "type": "string", "format": "uri" }
            }
          }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["dir", "dsh", "claude-code", "codex"] }
        },
        "visibility": {
          "enum": ["public", "unlisted", "internal", "private"],
          "default": "private",
          "description": "public 才会进公共索引；internal 走内网 registry；private 不发布"
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packhub"],
      "properties": {
        "packhub": { "type": "string" },
        "agent": { "type": "string" }
      }
    },
    "vars": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean"]
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/resource" }
    },
    "composition": { "$ref": "#/definitions/composition" },
    "slots": {
      "type": "object",
      "description": "可替换位：每个槽位声明契约，资源用 slot 占位，bindings 决定装哪个",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contract": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "note": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "bindings": {
      "type": "object",
      "description": "槽位 → 资源 id；只有被绑定的实现会被安装",
      "additionalProperties": { "type": "string" }
    },
    "paths": {
      "type": "object",
      "description": "包统一发号施令的路径表，资源里用 ${paths.x} 引用；必须是相对路径",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "overrides": { "$ref": "#/definitions/overrides" },
    "signatures": {
      "type": "array",
      "description": "对 {pack, planHash} 的 ed25519 签名；key 是 32 字节公钥 base64",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "sig"],
        "properties": {
          "key": { "type": "string" },
          "sig": { "type": "string" },
          "at": { "type": "string" }
        }
      }
    },
    "overlays": {
      "type": "array",
      "description": "装完之后按路径覆盖目标文件：mod 的 mod，用来改上游组件而不动它本身",
      "items": { "$ref": "#/definitions/overlay" }
    },
    "install": { "$ref": "#/definitions/install" },
    "verify": {
      "type": "array",
      "items": { "$ref": "#/definitions/check" }
    }
  },
  "definitions": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "type": { "enum": ["mcp", "skill", "prompt", "knowledge", "config", "tool"] },
        "source": {
          "type": "string",
          "pattern": "^(npm|pypi|github|packhub|https?):.+|^\\./.*$"
        },
        "integrity": { "type": "string", "pattern": "^sha256-[A-Za-z0-9+/=]+$" },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "description": "只声明需要哪个凭证，绝不写值",
          "required": ["env"],
          "properties": {
            "env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "scheme": { "enum": ["bearer", "token", "basic"], "default": "bearer" }
          }
        },
        "slot": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "transport": { "enum": ["stdio", "http"] },
        "config": { "type": "object" },
        "provides": { "$ref": "#/definitions/capabilities" },
        "needs": { "$ref": "#/definitions/capabilities" },
        "dependsOn": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        },
        "optional": { "type": "boolean", "default": false }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "mcp" } }, "required": ["type"] },
          "then": { "required": ["transport"] }
        },
        {
          "if": { "properties": { "source": { "pattern": "^https?:" } }, "required": ["source"] },
          "then": { "required": ["integrity"] }
        }
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*:[a-z0-9_.]+$"
      },
      "uniqueItems": true
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "env": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "order": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability", "requires"],
            "properties": {
              "capability": { "type": "string" },
              "requires": { "$ref": "#/definitions/capabilities" },
              "bind": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
            }
          }
        }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from"],
      "properties": {
        "from": { "type": "string", "pattern": "^\\./.*" },
        "to": { "type": "string", "default": "." },
        "include": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string", "maxLength": 200 }
      }
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource"],
        "properties": {
          "resource": { "type": "string" },
          "source": { "type": "string" },
          "config": { "type": "object" }
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exec": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command"],
            "properties": {
              "command": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } },
              "cwd": { "type": "string" },
              "env": { "type": "object", "additionalProperties": { "type": "string" } },
              "timeout": { "type": "integer", "minimum": 1 },
              "undo": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "command": { "type": "string" },
                  "args": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["file-exists", "command", "config-key", "mcp-ready", "knowledge-integrity"] },
        "path": { "type": "string" },
        "run": { "type": "array", "items": { "type": "string" } },
        "expectExit": { "type": "integer" },
        "timeout": { "type": "integer", "minimum": 1 },
        "key": { "type": "string" },
        "equals": { "type": ["string", "number", "boolean"] },
        "resource": { "type": "string" },
        "integrity": { "type": "string" }
      }
    }
  }
}
