{
  "name": "packhub",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:kernel": "vitest run packages/kernel/test",
    "test:runtime": "vitest run packages/runtime/test",
    "test:runner": "vitest run packages/runner/test",
    "test:registry": "vitest run packages/registry/test",
    "test:hub": "vitest run packages/hub/test",
    "typecheck": "tsc --noEmit --pretty false",
    "packhub": "node --experimental-strip-types apps/local/src/bin.ts",
    "pal": "node --experimental-strip-types packages/launcher/src/bin.ts",
    "pal:smoke": "node scripts/pal/smoke.mjs",
    "pal:bundle": "node scripts/pal/bundle.mjs",
    "pal:runtime": "node scripts/pal/stage-runtime.mjs",
    "pal:pack": "node scripts/pal/stage-runtime.mjs && pnpm --filter @packhub/pal-electron run pack",
    "electron:pal": "pnpm --filter @packhub/pal-electron start",
    "build:local": "node scripts/build-local.mjs",
    "pack:local": "node scripts/build-local.mjs && cd dist/local && npm pack",
    "registry:index": "node --experimental-strip-types scripts/registry/build-index.mjs",
    "registry:pack": "node --experimental-strip-types scripts/registry/build-archives.mjs",
    "registry:check": "node --experimental-strip-types scripts/registry/build-index.mjs --check",
    "registry:verify": "node --experimental-strip-types scripts/registry/verify-pack.mjs",
    "registry:verify-all": "node --experimental-strip-types scripts/registry/verify-all.mjs",
    "registry:verify-all:offline": "node --experimental-strip-types scripts/registry/verify-all.mjs --skip-network",
    "verify:examples": "node --experimental-strip-types scripts/verify-examples.mjs",
    "verify:examples:offline": "node --experimental-strip-types scripts/verify-examples.mjs --skip-network",
    "check": "pnpm typecheck && pnpm test",
    "docs:audit": "node scripts/docs-audit.mjs",
    "bench": "node --experimental-strip-types scripts/bench.ts",
    "bench:check": "node --experimental-strip-types scripts/bench.ts 200 --check",
    "bench:install": "node --experimental-strip-types scripts/bench.ts 200 --install",
    "bench:overlay": "node --experimental-strip-types scripts/bench.ts 200 --overlay --check",
    "bench:large": "node --experimental-strip-types scripts/bench.ts 1000 --overlay --install"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
